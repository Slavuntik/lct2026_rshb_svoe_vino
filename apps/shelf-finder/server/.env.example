# Export into the shell before starting uvicorn; baseline needs no external API.
CUDA_VISIBLE_DEVICES=2
SHELF_MODELS_DIR=/absolute/path/to/shelf-finder/artifacts/server-models
# Optional: serve the compiled interface and API from one origin.
SHELF_STATIC_DIR=/absolute/path/to/shelf-finder/dist
# Empty for same-origin. For a separate frontend, set its exact HTTPS origin.
SHELF_CORS_ORIGINS=

SHELF_PROFILE=baseline

# CPU/GPU selection for shelf only (independent of WineScan).
SHELF_DEVICE=auto
SHELF_CPU_THREADS=4
SHELF_SCAN_TIMEOUT_SECONDS=300
# Optional profile: set SHELF_PROFILE=litellm to enable Qwen refinement.
# If omitted, URL/key fall back to VISION_LLM_URL/VISION_LLM_KEY.
# SHELF_LITELLM_URL=https://your-model-gateway/v1
# SHELF_LITELLM_API_KEY=
SHELF_LITELLM_MODEL=qwen3.8-27b-uncensored
# Total network deadline; response <=256 KiB; two failures trigger a 30s cooldown.
SHELF_LITELLM_TIMEOUT=60
SHELF_LITELLM_LIMIT=3
# Optional reference PNGs, named <catalog-id>.png; never raw shelf photos.
# SHELF_LITELLM_REFERENCES_DIR=/absolute/path/to/reference_views
# Full remote shelf service for the root launcher; omit to start locally.
# VINCHIK_SHELF_URL=http://gpu-host:8086
