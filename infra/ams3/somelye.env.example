# Окружение хак-стенда на ams3. Реальный файл — /opt/somelye/somelye.env (600, владелец somelye);
# JWT_SECRET дописывается bootstrap.sh на сервере и никуда не уходит. LLM-ключа пока нет:
# LLM_PROVIDER=mock — сомелье отвечает заглушкой, сканер и аналоги работают полностью.
IMAGE_PROVIDER=real
VERIFIER_PROVIDER=real
RAG_PROVIDER=real
RAG_MODE=embedded
RAG_DATA_DIR=/opt/somelye/data/rag
RAG_FASTEMBED_CACHE=/opt/somelye/data/fastembed
CV_DATA_DIR=/opt/somelye/data/cv
CASE_DATA_DIR=/opt/somelye/data/case
CV_EVAL_REPORT_PATH=/opt/somelye/data/eval_report_snapshot.json
HF_HOME=/opt/somelye/data/models/hf
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
PADDLE_PDX_CACHE_HOME=/opt/somelye/data/models/paddlex
PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=True
# oneDNN у paddlepaddle 3.3.1 на этом CPU падает внутри себя (ConvertPirAttribute2Runtime-
# Attribute, PIR+oneDNN) — движок молча возвращает пустой текст, и верификатор честно
# воздерживается: near-dup перестаёт различаться. Отключение ускорителя чинит распознавание
# (проверено: читает «МУСКАТЕЛЬ … БЕЛЫЙ … 2023» и выбирает верный слаг), ценой скорости.
PADDLE_PDX_ENABLE_MKLDNN_BYDEFAULT=0
FLAGS_use_mkldnn=0
# Лёгкий детектор + кадр 256 px: 2.5 с на верификацию против 2.9 с (320 px), вердикт тот же.
# CV_OCR_DET_MODEL/CV_OCR_REC_MODEL/CV_OCR_SIZE здесь НЕ задаются намеренно (проверено на
# этом боксе): мобильный детектор быстрее на ~0.6 с, но теряет решающую строку этикетки
# («МУСКАТЕЛЬ» у пары Массандры) — остаётся только цвет, три кандидата дают ничью и
# верификатор воздерживается. Плюс PaddleOCR игнорирует lang=ru, едва задано ЛЮБОЕ имя
# модели, и кириллица читается латинским распознавателем как мусор. Штатные модели +
# 320 px: верный слаг, ocr_verified=true, ~2.5-3 с на верификацию (CPU без oneDNN).
DATABASE_URL=sqlite:////opt/somelye/data/db/somelye.db
LLM_PROVIDER=mock
# Три потока из четырёх vCPU — одно ядро всегда остаётся VPN.
OMP_NUM_THREADS=3
MKL_NUM_THREADS=3
TOKENIZERS_PARALLELISM=false
# Архив сканов из интерфейса (контракт v0.4.10): confident/ unsure/ failed/ + сайдкары.
# Забрать к себе: bash infra/ams3/pull-scans.sh 89.110.72.101
SCAN_ARCHIVE_DIR=/opt/somelye/data/scans
