# Окружение хак-стенда на ams3. Реальный файл — /opt/somelye/somelye.env (600, владелец somelye);
# JWT_SECRET дописывается bootstrap.sh на сервере и никуда не уходит. LLM-ключа пока нет:
# LLM_PROVIDER=mock — сомелье отвечает заглушкой, сканер и аналоги работают полностью.
# Хак: российская модель — GigaChat (инструкция в README, раздел «Подключение GigaChat»); пока без
# её ключа — свой Qwen 27B через OpenAI-совместимый шлюз (README, раздел «Подключение LLM через шлюз»).
IMAGE_PROVIDER=real
VERIFIER_PROVIDER=real
RAG_PROVIDER=real
RAG_MODE=embedded
RAG_DATA_DIR=/opt/somelye/data/rag
RAG_FASTEMBED_CACHE=/opt/somelye/data/fastembed
CV_DATA_DIR=/opt/somelye/data/cv
# С 21.09 индекс — base-384 после чистки эталонов (везётся sync-data.sh с
# CV_INDEX_DIR=packages/cv/data-d1); энкодер обязан совпадать с тем, которым строился индекс.
CV_MODEL=google/siglip2-base-patch16-384
# Слияние CV + текст этикетки по всему каталогу (contracts/image-scan.md v0.4.13): на живых фото
# 51.6% → 75.8% top-1 с PaddleOCR, 93.5% с моделью на GPU-сервере.
CV_FUSION=1
CV_FUSION_W=0.3
# agents/H2-rapidocr-multiscale.md: RapidOCR (ONNX Runtime) вместо PaddleOCR для
# read_query_text() — на живых фото 82-90% top-1 (2/8 кропов CV) и ~0.34 с на кроп
# 640px против 4.0 с у PaddleOCR на ЭТОМ ЖЕ 4-vCPU CPU (не зависит от бага oneDNN
# ниже). VLM (CV_FUSION_TEXT_SOURCE=vlm) остаётся основным источником текста —
# rapid здесь только МЕНЯЕТ OCR-фолбэк (когда VLM не ответила к дедлайну/выключена)
# с медленного PaddleOCR на быстрый RapidOCR; сама модель PaddleOCR при этом вообще
# не грузится в процесс (CV_FUSION_VERIFY не задан = 0 = near-dup verify() не
# вызывается), экономя RAM и время старта на этом слабом боксе.
CV_OCR_ENGINE=rapid
CV_OCR_RAPID_SIZES=640,960
# agents/H3-label-crop-ocr.md: третий проход — детектор+распознаватель RapidOCR на
# КРОПЕ ЭТИКЕТКИ при 1280px (боксы переиспользуются из прохода 960 выше, лишней
# детекции нет) — на живых фото +1 фото (90.3% -> 91.9% top-1, 2 кропа CV). "0"
# выключает проход целиком (откат без снижения точности ниже H2-базы 90.3%).
CV_OCR_LABEL_SIZE=1280
# 2 (не 8): на 4 vCPU 8 кропов — ~7 с ТОЛЬКО эмбеддинги (см. reports/cpu-path-study.md,
# оценка для 16 vCPU — ~2.5-3 с; на этом слабом боксе 8 кропов рискует бюджетом 10 с
# performance-теста кейса вместе с CV+текстом+OCR). Локальный dev-стенд (Mac, см.
# infra/local-check/run-check-server.sh) ставит 8 — там бюджет свободнее.
CV_FUSION_CROPS=2
# Текст этикетки — модель на GPU-сервере. Адрес/ключ дописывает push-release.sh из секретов
# GitHub VISION_LLM_URL/VISION_LLM_KEY; без них модель не вызывается и работает RapidOCR
# (CV_OCR_ENGINE выше) — раньше здесь был PaddleOCR-фолбэк.
# Локальной модели (MLX) на этом Linux-боксе нет — vlm_local/vlm_both только на Mac.
CV_FUSION_TEXT_SOURCE=vlm
# Тимлид 22.09 (задача hack-v15, решение Вячеслава: "модель и локальный путь стартуют
# одновременно; модель не ответила за 6 с — отдаём локальный ответ"): 6.5 -> 6.0, тот же
# код-дефолт (apps/api/app/config.py) — явная строка переживает будущую смену дефолта в коде.
VISION_LLM_TIMEOUT_S=6.0
# reports/ml-lead-choose-rule.md (62 живых фото + 38 честных NONE, боевая cv.text_fusion.fuse()):
# доверяем модели, только если её СОБСТВЕННЫЙ ответ проходит уже откалиброванный гейт уверенности
# (result.confident), иначе локальный (CV+OCR) — независимо от согласия слагов. Решение тимлида
# "в бой" hack-v15 (дефолт кода по-прежнему "merge", см. apps/api/app/config.py::cv_fusion_choose).
CV_FUSION_CHOOSE=confident_else_cv
# CV_SCAN_BUDGET_S/VISION_LLM_BREAKER_FAILS/VISION_LLM_BREAKER_COOLDOWN_S — НЕ заданы здесь
# намеренно (решение тимлида hack-v15): код-дефолты 7.5с/3/60с уже безопасны, явная строка
# добавляется только когда значение отличается от дефолта.
# ML-1 (reports/ml-eng-ml1.md): текст OCR добавляется к тексту модели через пробел (не
# только фолбэк на случай молчания модели) — офлайн на Mac 95.2% → 96.8% top-1 (режим vlm).
# На этом стенде VLM не настроена (VISION_LLM_URL/KEY пусты, см. выше) — мерджить с пустым
# текстом нечего, флаг безвреден; включаем заранее, чтобы не терять точность, когда шлюз появится.
CV_FUSION_MERGE_MODEL_TEXT=1
# ML-2 (reports/ml-eng-ml2.md, 22.09): CV_SHELF_CROP — сегментация кадра ЦЕЛОЙ ПОЛКИ на
# бутылки перед конвейером (packages/cv/cv/shelf_crop.py), нужна для полевых фото
# нескольких бутылок в кадре. НЕ включаем: живая приёмка на своей копии индекса дала
# регрессию 59/62 -> 58/62 на фото каталога (ложное срабатывание гейта "это полка" на
# одиночной бутылке спутало near-dup пару) и не подтвердила офлайн-прирост на 8 полевых
# целевых фото (1/8 с флагом и без). CV_SHELF_CROP=0 (код-дефолт) не трогаем, пока кто-то
# не разберёт эту регрессию отдельно.
# ML-3 (reports/ml-eng-ml3.md, 22.09): доп. сигнал CV_SHELF_MIN_TEXT_ASPECT (гейт
# text_aspect>=1.2 поверх v1, код-дефолт уже 1.2) закрыл РОВНО регрессию ML-2 (62/62
# каталога без изменений относительно флага-выключен, "87.88_...webp" в том числе) —
# но живая приёмка нашла НОВУЮ регрессию того же класса на честном NONE (Field/F09,
# not_in_catalog True->False) и поле 8 целевых не сдвинулось (1/8, как в ML-2; гейт
# срабатывает на 6/8 — совпадает с офлайн-прогнозом ml-lead, — но распознавание по
# кропу на TEXT_SOURCE=ocr не даёт top-1 ни на одном). CV_SHELF_CROP=0 не трогаем.
CASE_DATA_DIR=/opt/somelye/data/case
CV_EVAL_REPORT_PATH=/opt/somelye/data/eval_report_snapshot.json
HF_HOME=/opt/somelye/data/models/hf
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
# agents/H2-rapidocr-multiscale.md: весь блок PADDLE_PDX_*/CV_OCR_DET_MODEL и т.п. ниже
# ДРЕМЛЕТ, пока CV_OCR_ENGINE=rapid выше и CV_FUSION_VERIFY не включён (=0, PaddleOCR
# тогда не грузится в процесс вовсе) — оставлено НЕ удалённым на случай отката движка
# (CV_OCR_ENGINE=paddle) или включения CV_FUSION_VERIFY (near-dup verify() всегда
# PaddleOCR, независимо от CV_OCR_ENGINE — см. cv/verify.py).
PADDLE_PDX_CACHE_HOME=/opt/somelye/data/models/paddlex
PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=True
# oneDNN у paddlepaddle 3.3.1 на этом CPU падает внутри себя (ConvertPirAttribute2Runtime-
# Attribute, PIR+oneDNN) — движок молча возвращает пустой текст, и верификатор честно
# воздерживается: near-dup перестаёт различаться. Отключение ускорителя чинит распознавание
# (проверено: читает «МУСКАТЕЛЬ … БЕЛЫЙ … 2023» и выбирает верный слаг), ценой скорости.
PADDLE_PDX_ENABLE_MKLDNN_BYDEFAULT=0
FLAGS_use_mkldnn=0
# Лёгкий детектор + кадр 256 px: 2.5 с на верификацию против 2.9 с (320 px), вердикт тот же.
# CV_OCR_DET_MODEL/CV_OCR_REC_MODEL/CV_OCR_SIZE здесь НЕ задаются намеренно (проверено на
# этом боксе): мобильный детектор быстрее на ~0.6 с, но теряет решающую строку этикетки
# («МУСКАТЕЛЬ» у пары Массандры) — остаётся только цвет, три кандидата дают ничью и
# верификатор воздерживается. Плюс PaddleOCR игнорирует lang=ru, едва задано ЛЮБОЕ имя
# модели, и кириллица читается латинским распознавателем как мусор. Штатные модели +
# 320 px: верный слаг, ocr_verified=true, ~2.5-3 с на верификацию (CPU без oneDNN).
DATABASE_URL=sqlite:////opt/somelye/data/db/somelye.db
LLM_PROVIDER=mock
# Корень Минцифры для TLS к GigaChat (цепочки Сбера в стандартных хранилищах не доверены).
# Отпечаток SHA-256 D2:6D:2D:02:31:B7:C3:9F:92:CC:73:85:12:BA:54:10:35:19:E4:40:5D:68:B5:BD:70:3E:97:88:CA:8E:CF:31
# сверен по двум независимым источникам (Госуслуги и цепочка gigachat.devices.sberbank.ru).
GIGACHAT_CA_BUNDLE=/opt/somelye/certs/russian_trusted_root_ca.pem
# GIGACHAT_AUTH_KEY=<авторизационный ключ — ставится на сервере, в git и чат не попадает>
# GIGACHAT_SCOPE=GIGACHAT_API_PERS      # физлицо; для ИП/юрлица — GIGACHAT_API_B2B / GIGACHAT_API_CORP
# LLM_MODEL=GigaChat                    # базовая; GigaChat-Pro / GigaChat-Max — качественнее и дороже
#
# Альтернатива без ключа GigaChat (решение Вячеслава 22.09, reports/backend-llm-openai.md): свой
# Qwen3.8-27b на GPU-сервере команды через OpenAI-совместимый шлюз (LiteLLM, /v1/chat/completions,
# Bearer-ключ, SSE-стрим). Раскомментировать вместо блока GigaChat выше — активен только тот
# провайдер, что указан в LLM_PROVIDER, оба сразу смысла не имеют. Адрес шлюза и ключ — секреты,
# в git не попадают (README, раздел «Подключение LLM через шлюз»).
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://<gpu-host>/v1    # адрес шлюза — секрет, ставится только на сервере
# LLM_API_KEY=<ключ шлюза — ставится на сервере, в git и чат не попадает>
# LLM_MODEL=qwen3.8-27b                 # дефолт драйвера при пустом значении — можно не задавать
# Три потока из четырёх vCPU — одно ядро всегда остаётся VPN.
OMP_NUM_THREADS=3
MKL_NUM_THREADS=3
TOKENIZERS_PARALLELISM=false
# Архив сканов из интерфейса (контракт v0.4.10): confident/ unsure/ failed/ + сайдкары.
# Забрать к себе: bash infra/ams3/pull-scans.sh 89.110.72.101
SCAN_ARCHIVE_DIR=/opt/somelye/data/scans

# Порог уверенности гейта и штраф за противоречие цвета — калибровка 27.09
# (reports/ml-lead-floor-sweep.md): 0.80→0.77 даёт +4 уверенные карточки без единой новой
# ошибки и не трогает метрику жюри (плоский ответ формируется до гейта); штраф 0.05→0.10
# чинит случай, где красный бленд принимался за розовый того же производителя.
CV_FUSION_CV_FLOOR=0.77
CV_FUSION_COLOR_PENALTY=0.10

# Runtime cache outside the Git release (default also uses ~/.cache/vinchik/embeddings).
CV_EMBED_CACHE_DIR=/opt/somelye/data/cv-embed-cache
# Experimental name-consistency guard; keep disabled until acceptance.
CV_FUSION_NAME_GUARD=0
# Optional release smoke overrides; default reference lives in CASE_DATA_DIR/thumbs.
# RELEASE_SCAN_SMOKE_SLUG=chateau-tamagne-nature-vert
# RELEASE_SCAN_SMOKE_IMAGE=/opt/somelye/data/case/thumbs/chateau-tamagne-nature-vert.webp
