# infra/.env.prod.example — шаблон. Реальный файл: /opt/somelye/prod/.env на хосте,
# chmod 600, владелец — деплой-юзер, НИКОГДА не коммитится (корневой .gitignore уже
# игнорирует файлы `.env`; этот *.example — единственное, что должно быть в git).
#
# Как применяется: docker compose --env-file .env -f compose.prod.yml ...
# (или просто `.env` рядом с compose-файлом — Compose подхватывает его автоматически).
# Полный список секретов, кто их выдаёт и как ротировать — infra/RUNBOOK.md, разделы
# «Секреты» и «Ротация ключей LLM».

# ---------------------------------------------------------------------------
# Postgres
# ---------------------------------------------------------------------------
POSTGRES_DB=svoy_somelye
POSTGRES_USER=svoy_somelye
POSTGRES_PASSWORD=CHANGE_ME_STRONG_RANDOM_PASSWORD

# ---------------------------------------------------------------------------
# API / JWT (apps/api, агент B)
# ---------------------------------------------------------------------------
JWT_SECRET=CHANGE_ME_RANDOM_64_HEX          # openssl rand -hex 32
JWT_EXPIRES_IN=3600

# ---------------------------------------------------------------------------
# LLM-адаптер (contracts/llm-adapter.md) — драйвер выбирается ТОЛЬКО через env,
# логики выбора в коде API нет. На прод по плану — deepseek; gigachat — следующий прод.
# ---------------------------------------------------------------------------
LLM_PROVIDER=deepseek                       # deepseek | gigachat | anthropic | mock
LLM_BASE_URL=https://api.deepseek.com       # используется драйвером deepseek (OpenAI-совместимый)
LLM_API_KEY=CHANGE_ME_LLM_API_KEY
LLM_MODEL=deepseek-chat

# Только если LLM_PROVIDER=gigachat (OAuth client credentials, contracts/llm-adapter.md):
GIGACHAT_CLIENT_ID=
GIGACHAT_CLIENT_SECRET=
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# ---------------------------------------------------------------------------
# Qdrant — адрес внутри docker-сети, менять не нужно (см. compose.prod.yml: environment).
# Явно оставлено здесь для видимости полного набора переменных окружения api.
# ---------------------------------------------------------------------------
# QDRANT_URL задаётся в compose.prod.yml (environment), не здесь.

# ---------------------------------------------------------------------------
# Образ (обновляется infra/scripts/deploy.sh на каждый релиз, руками не трогать)
# ---------------------------------------------------------------------------
API_IMAGE=ghcr.io/OWNER/svoy-somelye-api
API_IMAGE_TAG=latest
