# Окружение второго хак-стенда «cpulab» (46.243.211.32, 8 vCPU / 15 ГБ, без GPU, без VPN-соседа).
# Реальный файл — /opt/somelye/somelye.env (600, владелец somelye). Копия
# infra/ams3/somelye.env.example — тот же алгоритм слияния CV+текст, та же калибровка
# (перенесено с БОЕВОГО /opt/somelye/somelye.env на ams3 27.09, не из этого шаблона в git,
# который местами отстаёт от ручных правок на сервере — см. README «Секреты»). Отличаются
# ТОЛЬКО инфраструктурные строки, которые не меняют результат (пути к каталогам с тем же
# содержимым, число потоков, лимиты systemd) — специально, чтобы точность была бит-в-бит
# сравнима между стендами; сам алгоритм трогать нельзя было по заданию.
IMAGE_PROVIDER=real
VERIFIER_PROVIDER=real
RAG_PROVIDER=real
RAG_MODE=embedded
# rag-20260922 — тот же индекс (2103 вина), что на ams3 сегодня (healthz rag_index_version
# 20260922.1); заливается sync-data.sh с дефолтным RAG_INDEX_DST=rag-20260922.
RAG_DATA_DIR=/opt/somelye/data/rag-20260922
RAG_FASTEMBED_CACHE=/opt/somelye/data/fastembed
# cv-d1 — тот же индекс (base-384 после чистки эталонов D1), что на ams3 сегодня (healthz
# cv_index_version case-20260921-d1-b384); заливается sync-data.sh с дефолтным CV_INDEX_DST=cv-d1.
CV_DATA_DIR=/opt/somelye/data/cv-d1
CV_MODEL=google/siglip2-base-patch16-384
# Слияние CV + текст этикетки по всему каталогу (contracts/image-scan.md v0.4.13) — БЕЗ
# ИЗМЕНЕНИЙ от ams3, значения ниже алгоритмические (не инфраструктурные), трогать нельзя.
CV_FUSION=1
CV_FUSION_W=0.3
CV_OCR_ENGINE=rapid
CV_OCR_RAPID_SIZES=640,960
CV_OCR_LABEL_SIZE=1280
# 2, как на ams3 (не поднято, несмотря на 8 vCPU против 4 — задание требует сравнимую
# точность бит-в-бит; поднятие CV_FUSION_CROPS меняет сам расчёт fusion, не только скорость,
# и требует отдельного офлайн-замера точности, здесь не проводившегося). Кандидат на
# отдельную волну ПОСЛЕ приёмки этого стенда — см. README «Предложения».
CV_FUSION_CROPS=2
CV_FUSION_TEXT_SOURCE=vlm
# Тимлид 22.09 (hack-v15): модель и локальный путь стартуют одновременно, модель не
# ответила за 6 с — отдаём локальный ответ. Без изменений от ams3.
VISION_LLM_TIMEOUT_S=6.0
CV_FUSION_CHOOSE=confident_else_cv
CV_FUSION_MERGE_MODEL_TEXT=1
CASE_DATA_DIR=/opt/somelye/data/case
CV_EVAL_REPORT_PATH=/opt/somelye/data/eval_report_snapshot.json
HF_HOME=/opt/somelye/data/models/hf
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
PADDLE_PDX_CACHE_HOME=/opt/somelye/data/models/paddlex
PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=True
# oneDNN/paddlepaddle (задание 27.09: "ОБЯЗАТЕЛЬНО проверь, нужен ли обход на новом CPU") —
# ПРОВЕРЕНО на этом сервере (Intel Xeon Icelake, AVX-512/VNNI — другое ядро, чем "Common
# KVM"/AVX2 на ams3), решение и цифры — README «oneDNN на Icelake: проверка обхода».
# Строки ниже — ИТОГ этой проверки, не перенос "на всякий случай" с ams3.
PADDLE_PDX_ENABLE_MKLDNN_BYDEFAULT=0
FLAGS_use_mkldnn=0
DATABASE_URL=sqlite:////opt/somelye/data/db/somelye.db
# LLM_PROVIDER/LLM_MODEL — не секрет (см. infra/ams3/README.md, «Секреты GitHub»), перенесены
# как есть с ams3. LLM_BASE_URL/LLM_API_KEY — СЕКРЕТ, ставятся только на сервере (README).
LLM_PROVIDER=openai
LLM_MODEL=qwen3.8-27b
# LLM_BASE_URL=https://<gpu-host>/v1    # секрет — ставится только на сервере
# LLM_API_KEY=<ключ шлюза>              # секрет — ставится только на сервере
# Корень Минцифры для TLS к GigaChat — скопирован для паритета с ams3 (сейчас не
# используется, пока LLM_PROVIDER=openai; см. infra/ams3/README.md «Подключение GigaChat»).
GIGACHAT_CA_BUNDLE=/opt/somelye/certs/russian_trusted_root_ca.pem
# VISION_LLM_URL/VISION_LLM_KEY — СЕКРЕТ (адрес и ключ GPU-шлюза), ставятся только на
# сервере — README «Секреты».
# VISION_LLM_URL=<адрес шлюза>
# VISION_LLM_KEY=<ключ шлюза>
# 8 vCPU и НИКОГО рядом (на ams3 — 3 из 4, одно ядро отдано VPN): 6 из 8, два ядра — под
# nginx/systemd/OS. Не поднято до 8 намеренно — небольшой запас снижает риск, что редкий
# всплеск (GC, нагрузка ОС) вытолкнет инференс в очередь и раздует хвост латентности.
OMP_NUM_THREADS=6
MKL_NUM_THREADS=6
TOKENIZERS_PARALLELISM=false
# Архив сканов из интерфейса — перенесено с ams3 как часть переноса файла окружения
# (значение по умолчанию, поведение то же, что описано в infra/ams3/README.md).
SCAN_ARCHIVE_DIR=/opt/somelye/data/scans
# Калибровка гейта (задание 27.09, перенос последней волны с ams3, reports/ml-lead-floor-sweep.md):
# 0.77/0.10 — БЕЗ ИЗМЕНЕНИЙ, алгоритмические значения.
CV_FUSION_CV_FLOOR=0.77
CV_FUSION_COLOR_PENALTY=0.10
