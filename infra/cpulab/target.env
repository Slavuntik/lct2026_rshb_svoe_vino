# Единственное место с адресом/ключом cpulab по умолчанию (задание 27.09: "чтобы адрес
# не был зашит" — раньше он был бы продублирован в push-release.sh/sync-data.sh/pull-scans.sh
# по отдельности). Источники: push-release.sh, sync-data.sh, pull-scans.sh (в начале, до
# разбора аргументов) — `. "$(dirname "$0")/target.env"`. Переопределить без правки файла:
# переменные окружения CPULAB_HOST/CPULAB_KEY (те же имена, что секреты GitHub Actions
# CPULAB_HOST/CPULAB_SSH_KEY в .github/workflows/deploy-hack-cpulab.yml) или позиционные
# аргументы скриптов (они всё ещё старше и этого файла, и переменных окружения).
# НЕ секрет — публичный IP, ключ читается из файла на диске, значение сюда не попадает.
: "${CPULAB_HOST:=46.243.211.32}"
: "${CPULAB_KEY:=$HOME/.ssh/cpu_lab}"
