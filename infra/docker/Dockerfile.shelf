# syntax=docker/dockerfile:1.7
FROM python:3.12-slim@sha256:2f17fc044b579bab302c2e8054d3a686e2cb9a83de48e70534b94cd8ebbe06a9
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/* && useradd --uid 10001 --create-home app
WORKDIR /app
COPY apps/shelf-finder/server ./
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --no-deps torch==2.14.0+cpu --index-url https://download.pytorch.org/whl/cpu \
    && pip install '.[ml,vlm]'
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 \
    OPENBLAS_CORETYPE=Sandybridge OPENBLAS_NUM_THREADS=2 MALLOC_ARENA_MAX=2
USER app
EXPOSE 8086
CMD ["uvicorn", "shelf_api.app:app", "--host", "0.0.0.0", "--port", "8086"]
