# syntax=docker/dockerfile:1.7
FROM python:3.12-slim@sha256:2f17fc044b579bab302c2e8054d3a686e2cb9a83de48e70534b94cd8ebbe06a9 AS build
COPY --from=ghcr.io/astral-sh/uv:0.5.11 /uv /bin/uv
ENV UV_PROJECT_ENVIRONMENT=/opt/venv UV_LINK_MODE=copy
WORKDIR /repo
COPY packages/llm packages/llm
COPY packages/rag packages/rag
COPY packages/cv packages/cv
COPY apps/api apps/api
WORKDIR /repo/apps/api
ARG INTEGRATION=false
RUN --mount=type=cache,target=/root/.cache/uv \
    if [ "$INTEGRATION" = true ]; then \
      uv sync --frozen --no-dev --no-editable --extra integration; \
    else uv sync --frozen --no-dev --no-editable; fi

# Paddle dependencies ship overlapping cv2 files. Restore the locked headless wheel last.
RUN --mount=type=cache,target=/root/.cache/uv \
    if [ "$INTEGRATION" = true ]; then \
      CV_VERSION="$(/opt/venv/bin/python -c 'import importlib.metadata as m; print(m.version("opencv-python-headless"))')"; \
      uv pip install --python /opt/venv/bin/python --no-deps --reinstall-package opencv-python-headless "opencv-python-headless==$CV_VERSION"; \
    fi

FROM python:3.12-slim@sha256:2f17fc044b579bab302c2e8054d3a686e2cb9a83de48e70534b94cd8ebbe06a9
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --uid 10001 --create-home app \
    && mkdir -p /state /cache && chown app:app /state /cache
COPY --from=build /opt/venv /opt/venv
COPY pipeline/ref /opt/pipeline/ref
COPY pipeline/build /opt/pipeline/build
COPY pipeline/catalog /opt/pipeline/catalog
ENV PATH=/opt/venv/bin:$PATH PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
WORKDIR /home/app
USER app
EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers", "--forwarded-allow-ips", "*"]
