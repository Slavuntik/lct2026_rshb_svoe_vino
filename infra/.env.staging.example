# infra/.env.staging.example — шаблон. Реальный файл: /opt/somelye/staging/.env на хосте,
# chmod 600, НИКОГДА не коммитится. См. infra/.env.prod.example для построчных пояснений —
# здесь только то, что осознанно отличается от прода.

# ---------------------------------------------------------------------------
# Postgres — ОТДЕЛЬНАЯ база от прода (тот же хост, другой compose-проект, свой volume:
# somelye_staging_pg_data). Значения должны отличаться от прод-пароля.
# ---------------------------------------------------------------------------
POSTGRES_DB=svoy_somelye_staging
POSTGRES_USER=svoy_somelye_staging
POSTGRES_PASSWORD=CHANGE_ME_STRONG_RANDOM_PASSWORD_STAGING

# ---------------------------------------------------------------------------
# API / JWT — свой секрет, НЕ переиспользовать прод-JWT_SECRET (иначе токен, выпущенный
# staging, был бы валиден и на прод, и наоборот).
# ---------------------------------------------------------------------------
JWT_SECRET=CHANGE_ME_RANDOM_64_HEX_STAGING
JWT_EXPIRES_IN=3600

# ---------------------------------------------------------------------------
# LLM-адаптер — по умолчанию mock: staging обновляется на каждый merge в main
# (.github/workflows/deploy.yml), гонять реальные LLM-ключи на каждый коммит — дорого
# и незачем. Перед тем как что-то показать вживую со staging, руками переключить на
# anthropic (dev/judge, contracts/llm-adapter.md) или тот же провайдер, что и в проде,
# и перезапустить: `docker compose -p staging -f infra/compose.staging.yml up -d api`.
# ---------------------------------------------------------------------------
LLM_PROVIDER=mock
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

GIGACHAT_CLIENT_ID=
GIGACHAT_CLIENT_SECRET=
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# ---------------------------------------------------------------------------
# Образ (обновляется infra/scripts/deploy.sh на каждый релиз, руками не трогать)
# ---------------------------------------------------------------------------
API_IMAGE=ghcr.io/OWNER/svoy-somelye-api
API_IMAGE_TAG=staging-latest
