# Copy to .env; do not commit credentials. Paths may be quoted.
VINCHIK_PYTHON=/absolute/path/to/python
VINCHIK_API_PORT=8087
VINCHIK_WEB_PORT=5173
SHELF_PORT=8086
# Select free physical GPUs before starting the two independent services.
VINCHIK_GPU=3
SHELF_GPU=2

RAG_PROVIDER=real
RAG_MODE=embedded
RAG_FASTEMBED_CACHE=/absolute/path/to/fastembed-cache
IMAGE_PROVIDER=winescan
VERIFIER_PROVIDER=real
CV_OCR_ENGINE=rapid
CV_TEXT_RERANK=1
WINESCAN_DEVICE=cuda:0
WINESCAN_ARTIFACTS_DIR=/absolute/path/to/winescan/artifacts
WINESCAN_UPLOADS_DIR=/absolute/path/to/strapi/uploads
CASE_DATA_DIR=/absolute/path/to/vinchik/case-data
SHELF_MODELS_DIR=/absolute/path/to/vinchik/apps/shelf-finder/artifacts/server-models

# OpenAI-compatible gateway; /v1 base, without /chat/completions.
LLM_PROVIDER=openai
LLM_BASE_URL=https://your-model-gateway/v1
LLM_MODEL=qwen3.8-27b
LLM_API_KEY=
VISION_LLM_URL=https://your-model-gateway/v1
VISION_LLM_MODEL=qwen3.8-27b
VISION_LLM_KEY=

# Optional shelf accuracy experiment; baseline remains the default.
# Model paths are resolved in apps/shelf-finder by tools/run_local.py.
SHELF_PROFILE=baseline
SHELF_ACCURACY_MODELS=artifacts/accuracy/models
SHELF_SEMANTIC_MODELS=artifacts/accuracy/semantic
SHELF_SEMANTIC_SCOPE=selected
SHELF_RESCUE_LIMIT=8
SHELF_BUDGET_SECONDS=12
SHELF_OCR=0

# CPU/GPU selection for shelf only (independent of WineScan).
SHELF_DEVICE=auto
SHELF_CPU_THREADS=4
SHELF_SCAN_TIMEOUT_SECONDS=300
# Optional profile: set SHELF_PROFILE=litellm to enable Qwen refinement.
# If omitted, URL/key fall back to VISION_LLM_URL/VISION_LLM_KEY.
# SHELF_LITELLM_URL=https://your-model-gateway/v1
# SHELF_LITELLM_API_KEY=
SHELF_LITELLM_MODEL=qwen3.8-27b-uncensored
SHELF_LITELLM_TIMEOUT=60
SHELF_LITELLM_LIMIT=3
# Optional reference PNGs, named <catalog-id>.png; never raw shelf photos.
# SHELF_LITELLM_REFERENCES_DIR=/absolute/path/to/reference_views
# Full remote shelf service for the root launcher; omit to start locally.
# VINCHIK_SHELF_URL=http://gpu-host:8086
