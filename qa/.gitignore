# Рантайм-артефакты qa/ — не деликты, генерируются заново при каждом прогоне.
# .venv/, __pycache__/, *.pyc уже покрыты корневым .gitignore; здесь — то, что специфично qa/.
.pytest_cache/
e2e/.dev-server.log
e2e/.api-server.log
e2e/.qa-real-run.db
test-results/
playwright-report/

# Отчёты scan_eval.py — журнал прогона над ЧЕМ-ТО-ЛИБО (мок, дев-фикстура, датасет кейса из
# CASE_DATA_DIR), не деликт: как test-results/ выше, пересобирается на каждый прогон. Ключевые
# цифры конкретных прогонов — в reports/f-report.md и qa/acceptance.md (цитатой), не сырым
# JSON/MD файлом — тот же принцип, что и остальная документация агента F.
scan-eval-runs/

# Синтетические «полевые» фото сканера (агент F2, qa/gen_synthetic_scan_photos.py) +
# локальный CV-индекс, построенный поверх них (qa/run_cv_index_baseline.py) — оба
# перегенерируются детерминированно по seed (см. докстринги скриптов), не деликты:
# сами фото — производные от packages/cv/devfix (G, тоже не в git), индекс — производный
# от них же плюс модель. Ключевые цифры конкретного прогона — в reports/f-report.md и
# qa/acceptance.md (цитатой), тот же принцип, что и scan-eval-runs/ выше.
synthetic/
